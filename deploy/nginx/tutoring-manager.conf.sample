# Sample host Nginx config — apply on the server's existing Nginx.
# Not run as a Compose service in this project.
#
# Upstream assumes Compose publishes app:8000 and web:8080 on localhost.
# Adjust server_name, TLS paths, and upstreams for your environment.

upstream tutoring_manager_api {
    server 127.0.0.1:8000;
}

upstream tutoring_manager_web {
    server 127.0.0.1:8080;
}

server {
    listen 443 ssl http2;
    server_name tutoring.example.com;

    # ssl_certificate     /etc/ssl/certs/tutoring.example.com.crt;
    # ssl_certificate_key /etc/ssl/private/tutoring.example.com.key;

    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://tutoring_manager_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass http://tutoring_manager_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

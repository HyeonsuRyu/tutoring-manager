APP_NAME=Tutoring Manager
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tutoring_manager

JWT_SECRET=change-me-in-development
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
COOKIE_SAMESITE=lax

MAIL_FROM=noreply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads
